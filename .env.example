# Postgres container credentials (used by docker-compose.yml)
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=woodmart_perfume

# Database connection string (docker-compose exposes Postgres on host port 5433)
DATABASE_URL=postgres://payload:payload@127.0.0.1:5433/woodmart_perfume

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Vercel Blob storage for media uploads (set automatically on Vercel when a Blob store is connected).
# Leave empty locally to store uploads in public/media.
BLOB_READ_WRITE_TOKEN=
